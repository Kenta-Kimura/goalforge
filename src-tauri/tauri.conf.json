{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoalForge",
  "version": "0.1.0",
  "identifier": "jp.kenta.goalforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GoalForge",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
